#!/bin/sh
set -eu

systemctl set-default graphical.target
systemctl enable lightdm.service
mkdir -p /etc/systemd/system/graphical.target.wants
ln -sfn /lib/systemd/system/graphical.target /etc/systemd/system/default.target
ln -sfn /lib/systemd/system/lightdm.service /etc/systemd/system/graphical.target.wants/lightdm.service
ln -sfn /lib/systemd/system/lightdm.service /etc/systemd/system/display-manager.service
install -d -m 0755 /usr/local/bin
chmod 0755 /usr/local/bin/valantiaos-graphical-check
install -d -m 0755 /etc/xdg/autostart
cat > /etc/xdg/autostart/valantiaos-graphical-check.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=ValantiaOS graphical verification
Exec=/usr/local/bin/valantiaos-graphical-check
OnlyShowIn=XFCE;
EOF
install -d -m 0755 /etc/sudoers.d
printf '%s\n' 'user ALL=(root) NOPASSWD: /usr/bin/tee -a /dev/ttyS0' > /etc/sudoers.d/valantiaos-graphical-check
chmod 0440 /etc/sudoers.d/valantiaos-graphical-check
install -d -m 0755 /var/lib/valantiaos
printf '%s\n' 'graphical-session hook completed' > /var/lib/valantiaos/graphical-session-hook-ran
