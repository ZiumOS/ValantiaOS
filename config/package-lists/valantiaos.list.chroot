
# ValantiaOS - XFCE base
xserver-xorg
xfce4
xfce4-terminal
lightdm
lightdm-gtk-greeter

# Debian's amd64 kernel metapackage tracks the latest kernel supported by Trixie.
linux-image-amd64

# Network and basic utilities
network-manager
network-manager-gnome
sudo
curl
vim-tiny
firefox-esr

# live-config creates the live user at *boot* time (not build time) via its
# user-setup component, which exits early unless this package is installed.
# It is only a Recommends of live-config, so --apt-recommends false drops it.
user-setup

# Graphics and Vulkan
mesa-vulkan-drivers
vulkan-tools

# Hardware firmware
firmware-linux
firmware-amd-graphics
firmware-intel-graphics
firmware-misc-nonfree

# Gaming performance and monitoring
gamemode
mangohud
