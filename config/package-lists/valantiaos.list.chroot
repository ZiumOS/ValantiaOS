
# ValantiaOS - XFCE base
xserver-xorg
xfce4
xfce4-terminal
lightdm
lightdm-gtk-greeter

# Valantia desktop apps: GTK runtime, PolicyKit authorization, and controls.
python3-gi
gir1.2-gtk-3.0
polkitd
pkexec
power-profiles-daemon
pavucontrol
pciutils

# Network and basic utilities
network-manager
network-manager-gnome
sudo
curl
vim-tiny
firefox-esr

# live-config creates the live user at *boot* time (not build time) via its
# user-setup component, which exits early unless this package is installed.
# It is only a Recommends of live-config, so --apt-recommends false drops it.
user-setup

# Graphics and Vulkan
mesa-vulkan-drivers
vulkan-tools

# Hardware firmware
firmware-linux
firmware-amd-graphics
firmware-intel-graphics
firmware-misc-nonfree

# Store dependency and system-wide Flatpak support
flatpak
gamemode
mangohud
