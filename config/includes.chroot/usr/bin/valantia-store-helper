#!/usr/bin/python3
import re
import subprocess
import sys

APT_NAME = re.compile(r"^[a-z0-9][a-z0-9+.-]{0,127}$")
FLATPAK_ID = re.compile(r"^[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)+$")

def fail(message):
    print(message, file=sys.stderr)
    raise SystemExit(1)

def valid_name(source, value):
    pattern = APT_NAME if source == "apt" else FLATPAK_ID
    if not pattern.fullmatch(value):
        fail("Invalid package identifier.")
    return value

if len(sys.argv) == 2 and sys.argv[1] == "update":
    raise SystemExit(subprocess.call(["/usr/bin/apt-get", "update"]))

if len(sys.argv) == 2 and sys.argv[1] == "update-flatpak":
    raise SystemExit(subprocess.call(["/usr/bin/flatpak", "update", "--system", "--noninteractive"]))

if len(sys.argv) == 4 and sys.argv[1] in {"install", "remove"}:
    operation, source, name = sys.argv[1:]
    if source not in {"apt", "flatpak"}:
        fail("Unsupported package source.")
    name = valid_name(source, name)
    if source == "apt":
        command = ["/usr/bin/apt-get", "install" if operation == "install" else "remove", "-y", name]
    else:
        command = ["/usr/bin/flatpak", operation, "--system", "-y", name]
    raise SystemExit(subprocess.call(command))

fail("Invalid Valantia Store operation.")
