#!/usr/bin/python3
import subprocess
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk

class Welcome(Gtk.Window):
    def __init__(self):
        super().__init__(title="Valantia Welcome")
        self.set_default_size(860, 600)
        self.set_border_width(28)
        self.connect("destroy", Gtk.main_quit)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        self.add(root)
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
        root.pack_start(head, False, False, 0)
        emblem = Gtk.Label()
        emblem.set_markup('<span size="xx-large" foreground="#6952a1">◢</span>')
        head.pack_start(emblem, False, False, 0)
        titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        title = Gtk.Label()
        title.set_markup('<span size="xx-large" weight="bold">Welcome to ValantiaOS</span>')
        title.set_xalign(0)
        titles.pack_start(title, False, False, 0)
        subtitle = Gtk.Label(label="A good place to begin. Explore the live desktop, make it yours, and get the essentials ready.")
        subtitle.set_xalign(0)
        subtitle.set_line_wrap(True)
        titles.pack_start(subtitle, False, False, 0)
        head.pack_start(titles, True, True, 0)

        grid = Gtk.Grid(column_spacing=14, row_spacing=14)
        grid.set_column_homogeneous(True)
        grid.set_row_homogeneous(True)
        root.pack_start(grid, True, True, 12)
        self.card(grid, 0, 0, "01  MAKE IT YOURS", "Tune performance, devices, display, audio, network, and background services.",
                  "Open Control Center", self.launch, "valantia-control-center")
        self.card(grid, 1, 0, "02  GET YOUR APPS", "Search curated Debian and Flatpak apps. Install, remove, or update with approval.",
                  "Open Valantia Store", self.launch, "valantia-store")
        self.card(grid, 0, 1, "03  GET CONNECTED", "Connect to Wi-Fi from the network icon in the panel. Plug in a drive to explore your files.",
                  "Network settings", self.launch, "nm-connection-editor")
        self.card(grid, 1, 1, "04  READ THE GUIDE", "Build instructions, live-session details, known limitations, and project updates.",
                  "Open documentation", self.open_docs, None)

        install = Gtk.Frame()
        install.get_style_context().add_class("install-card")
        install_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
        install_box.set_border_width(18)
        install.add(install_box)
        copy = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        label = Gtk.Label()
        label.set_markup('<b>Install ValantiaOS to this computer</b>')
        label.set_xalign(0)
        copy.pack_start(label, False, False, 0)
        note = Gtk.Label(label="This is an experimental live system. Installing changes disk partitions; back up your files first.")
        note.set_xalign(0)
        note.set_line_wrap(True)
        copy.pack_start(note, False, False, 0)
        install_box.pack_start(copy, True, True, 0)
        button = Gtk.Button(label="Check installer")
        button.get_style_context().add_class("suggested-action")
        button.connect("clicked", self.install)
        install_box.pack_end(button, False, False, 0)
        root.pack_start(install, False, False, 0)
        self.status = Gtk.Label(label="Live session · Changes are temporary unless you install the system")
        self.status.set_xalign(0)
        root.pack_end(self.status, False, False, 4)
        self.show_all()

    def card(self, grid, col, row, heading, detail, button_text, callback, target):
        frame = Gtk.Frame()
        frame.get_style_context().add_class("welcome-card")
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        content.set_border_width(18)
        frame.add(content)
        title = Gtk.Label()
        title.set_markup(f'<span size="small" foreground="#6952a1">{heading}</span>')
        title.set_xalign(0)
        content.pack_start(title, False, False, 0)
        text = Gtk.Label(label=detail)
        text.set_xalign(0)
        text.set_line_wrap(True)
        text.set_valign(Gtk.Align.START)
        content.pack_start(text, True, True, 0)
        action = Gtk.Button(label=button_text)
        action.set_halign(Gtk.Align.START)
        if target:
            action.connect("clicked", callback, target)
        else:
            action.connect("clicked", callback)
        content.pack_start(action, False, False, 0)
        grid.attach(frame, col, row, 1, 1)

    def launch(self, _button, command):
        try:
            subprocess.Popen([command])
        except OSError as error:
            self.status.set_text(f"Could not open {command}: {error}")

    def open_docs(self, _button):
        try:
            subprocess.Popen(["xdg-open", "https://github.com/ZiumOS/ValantiaOS"])
        except OSError as error:
            self.status.set_text(f"Could not open documentation: {error}")

    def install(self, _button):
        try:
            result = subprocess.run(["sh", "-c", "command -v calamares"], capture_output=True)
            if result.returncode == 0:
                subprocess.Popen(["pkexec", "calamares"])
                return
        except OSError:
            pass
        dialog = Gtk.MessageDialog(transient_for=self, flags=0,
            message_type=Gtk.MessageType.WARNING, buttons=Gtk.ButtonsType.CLOSE,
            text="Installer not available in this build")
        dialog.format_secondary_text(
            "The current ISO does not include a configured disk installer yet. "
            "No disk changes were made. Please keep using the live session and "
            "check the project documentation for installation support.")
        dialog.run()
        dialog.destroy()

if __name__ == "__main__":
    css = b"""
    window { background: #f4f1e9; color: #20252e; }
    .welcome-card, .install-card { background: #fffefa; border: 1px solid #d9d5cb; border-radius: 5px; }
    button { border-radius: 3px; }
    """
    provider = Gtk.CssProvider()
    provider.load_from_data(css)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    Welcome()
    Gtk.main()
