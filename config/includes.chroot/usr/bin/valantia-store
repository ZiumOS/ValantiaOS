#!/usr/bin/python3
import html
import re
import subprocess
import threading
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk

APT_CATALOG = [
    ("firefox-esr", "Firefox ESR", "Applications", "Web browser"),
    ("vlc", "VLC media player", "Applications", "Audio and video player"),
    ("gimp", "GIMP", "Applications", "Image editing"),
    ("blender", "Blender", "Development", "3D creation suite"),
    ("steam-installer", "Steam", "Games", "PC gaming platform"),
    ("lutris", "Lutris", "Games", "Game library manager"),
    ("godot", "Godot Engine", "Development", "Game development"),
    ("git", "Git", "Development", "Version control"),
]
FLATPAK_CATALOG = [
    ("org.mozilla.firefox", "Firefox", "Applications", "Web browser"),
    ("org.videolan.VLC", "VLC", "Applications", "Audio and video player"),
    ("org.gimp.GIMP", "GIMP", "Applications", "Image editing"),
    ("org.blender.Blender", "Blender", "Development", "3D creation suite"),
    ("com.valvesoftware.Steam", "Steam", "Games", "PC gaming platform"),
    ("net.lutris.Lutris", "Lutris", "Games", "Game library manager"),
    ("org.godotengine.Godot", "Godot Engine", "Development", "Game development"),
]

class Store(Gtk.Window):
    def __init__(self):
        super().__init__(title="Valantia Store")
        self.set_default_size(980, 690)
        self.connect("destroy", Gtk.main_quit)
        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.add(root)
        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        sidebar.set_size_request(205, -1)
        sidebar.set_border_width(22)
        sidebar.get_style_context().add_class("sidebar")
        root.pack_start(sidebar, False, False, 0)
        brand = Gtk.Label()
        brand.set_markup('<span size="large" weight="bold">◢ ValantiaOS</span>')
        brand.set_xalign(0)
        sidebar.pack_start(brand, False, False, 18)
        for category in ("Featured", "Applications", "Games", "Development", "Installed"):
            button = Gtk.Button(label=category)
            button.set_relief(Gtk.ReliefStyle.NONE)
            button.set_halign(Gtk.Align.FILL)
            button.connect("clicked", self.select_category, category)
            sidebar.pack_start(button, False, False, 0)
        sidebar.pack_end(Gtk.Label(label="DEBIAN REPOSITORIES · FLATHUB"), False, False, 4)

        main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        main.set_border_width(30)
        root.pack_start(main, True, True, 0)
        eyebrow = Gtk.Label(label="SOFTWARE  /  DISCOVER")
        eyebrow.set_xalign(0)
        main.pack_start(eyebrow, False, False, 0)
        title = Gtk.Label()
        title.set_markup('<span size="xx-large" weight="bold">Find your next app.</span>')
        title.set_xalign(0)
        main.pack_start(title, False, False, 0)
        self.search = Gtk.SearchEntry(placeholder_text="Search apps or package names…")
        self.search.connect("search-changed", self.render)
        main.pack_start(self.search, False, False, 0)
        toolbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.source = Gtk.ComboBoxText()
        self.source.append("apt", "Debian packages")
        self.source.append("flatpak", "Flatpak / Flathub")
        self.source.set_active_id("apt")
        self.source.connect("changed", self.render)
        toolbar.pack_start(self.source, False, False, 0)
        for label, operation in (("Update APT", "update"), ("Update Flatpaks", "update-flatpak")):
            button = Gtk.Button(label=label)
            button.connect("clicked", lambda _button, op=operation: self.run_admin(op))
            toolbar.pack_end(button, False, False, 0)
        main.pack_start(toolbar, False, False, 0)
        self.status = Gtk.Label(label="Ready · Package changes require authorization")
        self.status.set_xalign(0)
        main.pack_end(self.status, False, False, 0)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        main.pack_start(scroll, True, True, 0)
        self.results = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        scroll.add(self.results)
        self.category = "Featured"
        self.render()
        self.show_all()

    def select_category(self, _button, category):
        self.category = category
        self.render()

    def is_installed(self, package, source):
        if source == "apt":
            result = subprocess.run(["dpkg-query", "-W", "-f=${Status}", package],
                                    capture_output=True, text=True)
            return result.stdout.startswith("install ok installed")
        result = subprocess.run(["flatpak", "info", "--system", package],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return result.returncode == 0

    def render(self, *_args):
        for child in self.results.get_children():
            self.results.remove(child)
        source = self.source.get_active_id()
        catalog = APT_CATALOG if source == "apt" else FLATPAK_CATALOG
        query = self.search.get_text().strip().lower()
        for package, name, category, description in catalog:
            if self.category == "Games" and category != "Games":
                continue
            if self.category == "Development" and category != "Development":
                continue
            if self.category == "Applications" and category != "Applications":
                continue
            if self.category == "Featured" and package not in {
                    "firefox-esr", "steam-installer", "lutris", "vlc",
                    "org.mozilla.firefox", "com.valvesoftware.Steam", "net.lutris.Lutris", "org.videolan.VLC"}:
                continue
            installed = self.is_installed(package, source)
            if self.category == "Installed" and not installed:
                continue
            if query and query not in f"{package} {name} {category} {description}".lower():
                continue
            frame = Gtk.Frame()
            frame.set_shadow_type(Gtk.ShadowType.NONE)
            frame.get_style_context().add_class("card")
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
            row.set_border_width(16)
            frame.add(row)
            info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            heading = Gtk.Label()
            heading.set_markup(f'<b>{html.escape(name)}</b>  <span size="small">{html.escape(category)}</span>')
            heading.set_xalign(0)
            detail = Gtk.Label(label=f"{description} · {package}")
            detail.set_xalign(0)
            info.pack_start(heading, False, False, 0)
            info.pack_start(detail, False, False, 0)
            row.pack_start(info, True, True, 0)
            action = Gtk.Button(label="Remove" if installed else "Install")
            action.connect("clicked", self.package_action, "remove" if installed else "install", source, package)
            row.pack_end(action, False, False, 0)
            self.results.pack_start(frame, False, False, 0)
        self.results.show_all()

    def run_admin(self, operation, source="", package=""):
        self.status.set_text("Waiting for administrator authorization…")
        def worker():
            if operation in {"update", "update-flatpak"}:
                command = ["pkexec", "/usr/bin/valantia-store-helper", operation]
            else:
                command = ["pkexec", "/usr/bin/valantia-store-helper", operation, source, package]
            try:
                result = subprocess.run(command, capture_output=True, text=True, timeout=1800)
                message = "Operation completed" if result.returncode == 0 else "Operation cancelled or failed"
                if result.stderr.strip():
                    message += ": " + result.stderr.strip()[-180:]
            except (OSError, subprocess.TimeoutExpired) as error:
                message = f"Operation error: {error}"
            GLib.idle_add(self.status.set_text, message)
            GLib.idle_add(self.render)
        threading.Thread(target=worker, daemon=True).start()

    def package_action(self, _button, operation, source, package):
        self.run_admin(operation, source, package)

if __name__ == "__main__":
    css = b"""
    window { background: #f4f1e9; color: #20252e; }
    .sidebar { background: #202d46; color: #f4f1e9; }
    .sidebar button { color: #e6e2dc; text-align: left; padding: 10px; }
    .sidebar button:hover { background: #343f58; }
    .card { background: #fffefa; border: 1px solid #d9d5cb; border-radius: 5px; }
    """
    provider = Gtk.CssProvider()
    provider.load_from_data(css)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    Store()
    Gtk.main()
